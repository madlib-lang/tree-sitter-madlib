{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "madlib",
  "word": "_word",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "line_comment"
          },
          {
            "type": "SYMBOL",
            "name": "block_comment"
          },
          {
            "type": "SYMBOL",
            "name": "quoted_string"
          },
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "SYMBOL",
            "name": "attribute"
          },
          {
            "type": "SYMBOL",
            "name": "keyword"
          },
          {
            "type": "SYMBOL",
            "name": "_word"
          },
          {
            "type": "SYMBOL",
            "name": "_other"
          }
        ]
      }
    },
    "_word": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z_]\\w*"
      }
    },
    "quoted_string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^\"\\\\\\r\\n]"
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "\\"
                        },
                        {
                          "type": "PATTERN",
                          "value": "[^\\r\\n]"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^'\\\\\\r\\n]"
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "\\"
                        },
                        {
                          "type": "PATTERN",
                          "value": "[^\\r\\n]"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "`"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^`\\\\\\r\\n]"
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "\\"
                        },
                        {
                          "type": "PATTERN",
                          "value": "[^\\r\\n]"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "`"
              }
            ]
          }
        ]
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F][0-9a-fA-F_]*"
          },
          {
            "type": "PATTERN",
            "value": "[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?"
          },
          {
            "type": "PATTERN",
            "value": "\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?"
          }
        ]
      }
    },
    "attribute": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "(?:[iI][mM][pP][oO][rR][tT]|[tT][yY][pP][eE]|[fF][rR][oO][mM]|[iI][fF]|[eE][lL][sS][eE]|[eE][xX][pP][oO][rR][tT]|[rR][eE][tT][uU][rR][nN]|[dD][oO]|[wW][hH][eE][rR][eE])"
        }
      }
    },
    "keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "(?:[tT][rR][uU][eE]|[fF][aA][lL][sS][eE])"
        }
      }
    },
    "_other": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s]"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}